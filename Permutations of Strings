#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
 * Swaps two string pointers
 */
void swap(char **a, char **b) {
    char *temp = *a;
    *a = *b;
    *b = temp;
}

/**
 * Reverses an array of strings from index 'start' to 'end'
 */
void reverse(char **arr, int start, int end) {
    while (start < end) {
        swap(&arr[start], &arr[end]);
        start++;
        end--;
    }
}

/**
 * Generates the next lexicographical permutation.
 * Returns 1 if successful, 0 if it's the last permutation.
 */
int next_permutation(int n, char **s) {
    // 1. Find the largest index i such that s[i] < s[i+1]
    int i = n - 2;
    while (i >= 0 && strcmp(s[i], s[i + 1]) >= 0) {
        i--;
    }

    // If no such index exists, we are at the last permutation
    if (i < 0) {
        return 0;
    }

    // 2. Find the largest index j such that s[i] < s[j]
    int j = n - 1;
    while (strcmp(s[i], s[j]) >= 0) {
        j--;
    }

    // 3. Swap s[i] and s[j]
    swap(&s[i], &s[j]);

    // 4. Reverse the sequence from s[i+1] to the end
    reverse(s, i + 1, n - 1);

    return 1;
}




